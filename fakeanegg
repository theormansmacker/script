	local index = LocalPlayer:GetAttribute("Base")
	if not index then
		return nil
	end
	return workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild(tostring(index)) or nil
end

local function cash()
	local stats = LocalPlayer:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild("Cash")
	return value and value.Value or 0
end

local function rebirths()
	local stats = LocalPlayer:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild("Rebirths")
	return value and value.Value or 0
end

local function mySlots()
	local folder = LocalPlayer:FindFirstChild("Slots")
	return folder and folder:GetChildren() or {}
end

local function bestOwnWeight()
	local best = 0
	for _, slot in ipairs(mySlots()) do
		local weight = slot:GetAttribute("Weight")
		if weight and weight > best then
			best = weight
		end
	end
	return best
end

local function petWeight(name)
	local animal = name and Animals[name]
	return animal and animal.weight or 0
end

local function freeNest()
	local base = myBase()
	local slots = LocalPlayer:FindFirstChild("Nests")
	if not (base and slots) then
		return nil
	end
	local nests = base:FindFirstChild("Nests")
	if not nests then
		return nil
	end
	for _, nest in ipairs(nests:GetChildren()) do
		local slot = slots:FindFirstChild(nest.Name)
		if slot and slot:GetAttribute("Owned") and not slot:GetAttribute("Egg") then
			return nest
		end
	end
	return nil
end

local function isOn(key)
	local ref = UiRefs[key]
	if ref then
		local ok, value = pcall(function()
			return ref:Get()
		end)
		if ok then
			return value == true
		end
	end
	return Settings[key] == true
end

local function isRealEgg(model)
	if not model or not model.Parent then
		return false
	end
	if model:GetAttribute("Owner") ~= nil then
		return false
	end
	if not model:GetAttribute("IsEgg") or not model:GetAttribute("BaseName") then
		return false
	end
	if not model:GetAttribute("CountdownEnd") then
		return false
	end
	for _, child in ipairs(model:GetDescendants()) do
		if child:IsA("Humanoid") or child:IsA("Player") then
			return false
		end
	end
	return true
end

local function rebirthAnimal()
	local ok, data = pcall(Rebirth.getNext, rebirths())
	if ok and type(data) == "table" then
		return data.animal
	end
	return nil
end

local function eggNameList()
	local out, seen = {}, {}
	for _, info in pairs(Eggs.ByName) do
		local name = info.name
		if name and not seen[name] then
			seen[name] = true
			table.insert(out, name)
		end
	end
	table.sort(out)
	return out
end

local function eggRarityList()
	local out, seen = {}, {}
	for _, info in pairs(Eggs.ByName) do
		local rarity = info.rarityType
		if rarity and not seen[rarity] then
			seen[rarity] = true
			table.insert(out, rarity)
		end
	end
	table.sort(out)
