----------------------------------------------------------------------
-- 1. FARM
----------------------------------------------------------------------

local hatchCooldown = {}
local buyBlocked = {}

local function pickEgg(mode)
	local best, bestScore = nil, -1
	local money = cash()
	local bestWeight = bestOwnWeight()
	local now = os.clock()
	local wanted = mode == "rebirth" and rebirthAnimal() or nil
	local names = Settings.eggNames
	local rarities = Settings.eggRarities
	local realOnly = mode == "rebirth" or isOn("skipFake")

	for _, prompt in ipairs(workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") and prompt.ActionText == "Buy" and prompt.Parent and prompt.Enabled then
			local model = prompt.Parent
			local eggName = model:GetAttribute("BaseName")
			local info = eggName and Eggs.ByName[eggName]
			local blockedUntil = buyBlocked[prompt]
			local real = isRealEgg(model)
			if info and info.price <= money
				and (not Settings.maxPriceEnabled or info.price <= Settings.maxPrice)
				and not (blockedUntil and blockedUntil > now)
				and (real or not realOnly) then
				local petName = info.pet or info.name
				local allowed = true
				if wanted and petName ~= wanted then
					allowed = false
				end
				if allowed and names and next(names) and not names[eggName] then
					allowed = false
				end
				if allowed and rarities and next(rarities) and not rarities[info.rarityType or "Common"] then
					allowed = false
				end
				local weight = petWeight(petName)
				local score = info.rarity or 0
				if allowed and (mode == "rebirth" or not Settings.onlyBetter or weight > bestWeight) then
					if score > bestScore then
						best, bestScore = {
							prompt = prompt,
							info = info,
							weight = weight,
							price = info.price,
							real = real,
						}, score
					end
				end
			end
		end
	end
	return best
end

local function hatchReady()
	local now = workspace:GetServerTimeNow()
	local eggs = workspace:FindFirstChild("NestEggs")
	if not eggs then
		return
	end
	for _, model in ipairs(eggs:GetChildren()) do
		if model:GetAttribute("Owner") == LocalPlayer.Name and (hatchCooldown[model] or 0) < now then
			local prompt
			for _, child in ipairs(model:GetDescendants()) do
				if child:IsA("ProximityPrompt") and child.ActionText == "Hatch" then
					prompt = child
					break
				end
			end
			if prompt and prompt.Enabled then
				hatchCooldown[model] = now + 2
				local position = model:GetPivot().Position
				if teleport(position + Vector3.new(0, -1, 3)) then
					safeWait(0.12)
					if firePrompt(prompt) then
						state.text = T.hatching
						stats.hatched += 1
						log(string.format(T.logHatched, tostring(model:GetAttribute("BaseName"))))
					end
				end
				return true
			end
		end
	end
end

local function farmStep(mode)
	mode = mode or "normal"

	if LocalPlayer:GetAttribute("Carrying") then
		local nest = freeNest()
		if nest then
			teleport(nest:GetPivot().Position)
			state.text = mode == "rebirth" and T.rebirthFarming or T.farming
		else
			state.text = T.full
		end
		return
	end

	if not freeNest() then
		state.text = T.full
		return
	end

	if state.pendingPrompt then
		if os.clock() - (state.pendingAt or 0) > 1.5 then
			buyBlocked[state.pendingPrompt] = os.clock() + 20
			state.pendingPrompt = nil
			state.text = T.noEgg
		end
		return
	end

	local egg = pickEgg(mode)
	if not egg then
		if mode == "rebirth" then
			state.text = rebirthAnimal() and T.noEgg or T.rebirthNone
		else
			state.text = cash() < 100 and T.noMoney or T.noEgg
		end
		return
	end

	state.text = mode == "rebirth" and T.rebirthFarming or T.buying
	local position = promptPosition(egg.prompt)
	if position and teleport(position) then
		safeWait(0.15)
		if firePrompt(egg.prompt) then
			state.pendingPrompt = egg.prompt
			state.pendingAt = os.clock()
			state.egg = egg.info.displayName or egg.info.name
			log(string.format(T.logBuy, tostring(state.egg), egg.price))
		end
	end
end

local function confirmBuy()
	if state.pendingPrompt and LocalPlayer:GetAttribute("Carrying") then
		state.pendingPrompt = nil
		stats.bought += 1
		log(string.format(T.logBought, tostring(state.egg)))
	end
end

----------------------------------------------------------------------
-- 2. REVENGE THEFT DETECTION & INFILTRATION (Steal highest-value pet)
----------------------------------------------------------------------

local lastKnownMyPets = {}
local wasStolenFrom = false
local culpritBase = nil
local stealCooldown = 0

local function updateTheftDetection()
	local base = myBase()
	if not base then return end

	local currentPets = {}
	for _, child in ipairs(base:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			currentPets[child.Name] = true
		end
	end

	if next(lastKnownMyPets) ~= nil then
		for petName, _ in pairs(lastKnownMyPets) do
			if not currentPets[petName] and not LocalPlayer:GetAttribute("Carrying") then
				-- A pet was removed from our base without our action; find who took it!
				for _, otherBase in ipairs(workspace.Bases:GetChildren()) do
					if otherBase ~= base and otherBase:GetAttribute("Owner") then
						for _, op in ipairs(otherBase:GetChildren()) do
							if op.Name == petName then
								wasStolenFrom = true
								culpritBase = otherBase
								local ownerName = tostring(otherBase:GetAttribute("Owner"))
								log(string.format(T.logTheftDetected, ownerName))
								break
							end
						end
					end
					if wasStolenFrom then break end
				end
			end
		end
	end
	lastKnownMyPets = currentPets
end

--- Pick the pet that makes the most money (highest weight/value) from the culprit base
local function pickCulpritBestPet()
	if not wasStolenFrom or not culpritBase or not culpritBase.Parent then
		return nil
	end

	local best, bestWeight = nil, -1
	for _, pet in ipairs(culpritBase:GetChildren()) do
		if pet:IsA("Model") then
			local petName = pet.Name
			local weight = petWeight(petName)
			if weight > bestWeight then
				for _, child in ipairs(pet:GetDescendants()) do
					if child:IsA("ProximityPrompt") and child.ActionText == "Steal" then
						best, bestWeight = { prompt = child, pet = pet, base = culpritBase, name = petName, weight = weight }, weight
						break
					end
				end
			end
		end
	end

	-- If culprit base has no pets left, reset revenge state
	if not best then
		wasStolenFrom = false
		culpritBase = nil
	end
	return best
end

local function stealStep()
	updateTheftDetection()

	local now = os.clock()
	if now < stealCooldown then
		return
	end

	if LocalPlayer:GetAttribute("Carrying") then
		local nest = freeNest()
		if nest then
			teleport(nest:GetPivot().Position)
			state.text = T.farming
		end
		return
	end

	-- Only infiltrate and steal if we have been stolen from!
	if not wasStolenFrom or not culpritBase then
		state.text = T.noTarget
		return
	end

	local target = pickCulpritBestPet()
	if not target then
		state.text = T.noTarget
		return
	end

	state.text = T.stealing
	local position = promptPosition(target.prompt)
	if position and teleport(position) then
		safeWait(0.15)
		-- Instant steal by pressing 'E'
		local fired = instantStealPrompt(target.prompt)
		if not fired then
			local owner = target.base:GetAttribute("Owner")
			local player = owner and Players:FindFirstChild(owner)
			if player then
				pcall(function()
					Remotes.StealEvent:FireServer(player.UserId, target.pet.Name)
				end)
				fired = true
			end
		end

		if fired then
			stats.stolen += 1
			stealCooldown = now + 2.5
			log(string.format(T.logStolen, target.name, target.weight))
			
			-- Reset revenge trigger until next theft occurs
			wasStolenFrom = false
			culpritBase = nil

			if Settings.returnHome then
				local base = myBase()
				if base then
					teleport(base.Spawn.Position)
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- 3. SHOPS AND SELLING
----------------------------------------------------------------------

local scannerCooldown, foodCooldown, sellCooldown = 0, 0, 0
local shopPending = { scanner = nil, food = nil }
local sellPending = nil

local function shopPosition(name)
	local map = workspace:FindFirstChild("Map")
	local model = map and map:FindFirstChild(name)
	return model and model:GetPivot().Position or nil
end

local function itemNameList(module)
	local out = {}
	for _, item in ipairs(module.List) do
		table.insert(out, item.name)
	end
	table.sort(out)
	return out
end

local function petNameList()
	local out = {}
	for name, info in pairs(Animals) do
		if type(name) == "string" and type(info) == "table" and info.weight and info.rarityType then
			table.insert(out, name)
		end
	end
	table.sort(out)
	return out
end

local function petRarityList()
	local out, seen = {}, {}
	for _, info in pairs(Animals) do
		if type(info) == "table" and info.weight and info.rarityType and not seen[info.rarityType] then
			seen[info.rarityType] = true
			table.insert(out, info.rarityType)
		end
	end
	table.sort(out)
	return out
end

local function selectedOptions(map)
	local out = {}
	for name, selected in pairs(map or {}) do
		if selected then
			table.insert(out, name)
		end
	end
	table.sort(out)
	return out
end

local function shopStock(kind, name)
	local module = kind == "scanner" and Scanners or Food
	local ok, stock = pcall(module.stock, LocalPlayer, name)
	if ok and type(stock) == "number" then
		return stock
	end
	local prefix = kind == "scanner" and "Stock" or "FoodStock"
	return LocalPlayer:GetAttribute(prefix .. name) or 0
end

local function bestShopItem(kind)
	local module = kind == "scanner" and Scanners or Food
	local chosen = kind == "scanner" and Settings.scannerTypes or Settings.foodTypes
	local filterOn = chosen and next(chosen) ~= nil
	local money = cash()
	local best, bestRank, bestStock = nil, -1, 0

	for _, item in ipairs(module.List) do
		local stock = shopStock(kind, item.name)
		local unlocked = rebirths() >= (item.rebirth or 0)
		local allowed = not filterOn or chosen[item.name] == true
		if allowed and unlocked and stock > 0 and item.price <= money and item.price <= Settings.shopMax then
			local rank = item.rank or 0
			if rank > bestRank then
				best, bestRank, bestStock = item, rank, stock
			end
		end
	end
	return best, bestStock
end

local function confirmShopPurchase(kind)
	local pending = shopPending[kind]
	if not pending then
		return
	end
	local currentStock = shopStock(kind, pending.item.name)
	if currentStock < pending.stock or cash() < pending.cash then
		if kind == "scanner" then
			stats.scanners += 1
		else
			stats.food += 1
		end
		log(string.format(T.logShop, pending.item.name, pending.item.price))
		shopPending[kind] = nil
	elseif os.clock() - pending.at > 2 then
		shopPending[kind] = nil
	end
end

local function shopStep(kind)
	local now = os.clock()
	if (kind == "scanner" and now < scannerCooldown) or (kind == "food" and now < foodCooldown) then
		return false
	end

	local item, stock = bestShopItem(kind)
	if not item then
		state.shop[kind] = T.shopNothing
		return false
	end

	local position = shopPosition(kind == "scanner" and "Scanners" or "Food")
	if not position or not teleport(position + Vector3.new(0, 2, 5)) then
		return false
	end

	safeWait(0.15)
	local remote = kind == "scanner" and Remotes.ScannerEvent or Remotes.FoodEvent
	local ok = pcall(function()
		remote:FireServer("Buy", item.name)
	end)
	if not ok then
		return false
	end

	if kind == "scanner" then
		scannerCooldown = os.clock() + 2
	else
		foodCooldown = os.clock() + 2
	end
	shopPending[kind] = { item = item, stock = stock, cash = cash(), at = os.clock() }
	state.shop[kind] = item.name
	return true
end

local function parseInventoryPet(attr)
	local ok, key, pet, animal = pcall(function()
		local decoded = Animals.decodeAttr(attr)
		local name = Animals.parseSlot(decoded)
		return decoded, name, name and Animals[name] or nil
	end)
	if ok then
		return key, pet, animal
	end
	return nil
end

local function bestInventoryWeight()
	local inventory = LocalPlayer:FindFirstChild("Inventory")
	local best = 0
	if not inventory then
		return best
	end
	for attr, count in pairs(inventory:GetAttributes()) do
		if type(count) == "number" and count > 0 then
			local _, _, animal = parseInventoryPet(attr)
			if animal and (animal.weight or 0) > best then
				best = animal.weight
			end
		end
	end
	return best
end

local function sellKey()
	local inventory = LocalPlayer:FindFirstChild("Inventory")
	if not inventory then
		return nil
	end
	local best = math.max(bestOwnWeight(), bestInventoryWeight())
	local names = Settings.sellNames
	local rarities = Settings.sellRarities
	local namesOn = names and next(names) ~= nil
	local raritiesOn = rarities and next(rarities) ~= nil

	for attr, count in pairs(inventory:GetAttributes()) do
		if type(count) == "number" and count > 0
			and not (attr:match("_Size$") or attr:match("_Weight$") or attr:match("_Mood$")) then
			local key, pet, animal = parseInventoryPet(attr)
			if key and animal then
				local weight = animal.weight or 0
				local rarity = animal.rarityType or "Common"
				local allowed = true
				if namesOn and not names[pet] then
					allowed = false
				end
				if allowed and raritiesOn and not rarities[rarity] then
					allowed = false
				end
				if allowed and Settings.sellUnder > 0 and weight >= Settings.sellUnder then
					allowed = false
				end
				if allowed and Settings.keepBest and weight >= best and count <= 1 then
					allowed = false
				end
				if allowed then
					return key, pet, weight, attr, count
				end
			end
		end
	end
	return nil
end

local function confirmSale()
	if not sellPending then
		return
	end
	local inventory = LocalPlayer:FindFirstChild("Inventory")
	local count = inventory and inventory:GetAttribute(sellPending.attr) or 0
	if type(count) == "number" and count < sellPending.count then
		stats.sold += 1
		log(string.format(T.logSold, sellPending.pet, sellPending.weight))
		sellPending = nil
	elseif os.clock() - sellPending.at > 2 then
		sellPending = nil
	end
end

local function sellStep()
	local now = os.clock()
	if now < sellCooldown then
		return false
	end

	local key, pet, weight, attr, count = sellKey()
	if not key then
		state.sell = T.sellNone
		return false
	end

	local position = shopPosition("Sell")
	if not position or not teleport(position + Vector3.new(0, 2, 5)) then
		return false
	end

	safeWait(0.12)
	local ok = pcall(function()
		Remotes.SellEvent:FireServer(key)
	end)
	if not ok then
		return false
	end

	sellCooldown = os.clock() + math.max(0.5, Settings.sellEvery or 2)
	sellPending = { attr = attr, count = count, pet = pet, weight = weight, at = os.clock() }
	state.sell = pet
	return true
end

----------------------------------------------------------------------
-- 4. AUTO
----------------------------------------------------------------------

local rebirthCooldown, upgradeCooldown, disguiseCooldown, equipCooldown = 0, 0, 0, 0

local function autoStep()
	local now = os.clock()

	if isOn("rebirth") and now > rebirthCooldown then
		local ok, can = pcall(Rebirth.CanRebirth, LocalPlayer)
		if ok and can then
			rebirthCooldown = now + 3
			Remotes.RebirthEvent:FireServer()
			log(string.format(T.logRebirth, rebirths()))
		end
	end

	if isOn("upgrade") and now > upgradeCooldown then
		upgradeCooldown = now + 5
		local base = myBase()
		local sign = base and base:FindFirstChild("UpgradeSign")
		if sign then
			teleport(sign:GetPivot().Position)
			safeWait(0.15)
		end
		Remotes.BaseUpgradeEvent:FireServer()
	end

	if isOn("equipBest") and now > equipCooldown then
		equipCooldown = now + math.max(1, Settings.equipInterval or 5)
		Remotes.EquipBestEvent:FireServer()
	end

	if isOn("disguise") and now > disguiseCooldown and not LocalPlayer:GetAttribute("Disguised") then
		local base = myBase()
		local pipe = base and base:FindFirstChild("Pipe")
		if pipe then
			local prompt
			for _, child in ipairs(pipe:GetDescendants()) do
				if child:IsA("ProximityPrompt") and child.ActionText == "Disguise" then
					prompt = child
					break
				end
			end
			if prompt then
				disguiseCooldown = now + 8
				local position = promptPosition(prompt)
				if position and teleport(position) then
					safeWait(0.2)
					firePrompt(prompt)
					log(T.logPipe)
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- 4. ESP
----------------------------------------------------------------------

local espModels = {}

local function clearEsp()
	for model, box in pairs(espModels) do
		if box then
			box:Destroy()
		end
	end
	espModels = {}
end

local function drawEsp()
	if not Settings.esp then
		if next(espModels) then
			clearEsp()
		end
		return
	end

	local found = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player:GetAttribute("Disguised") then
			found += 1
			local char = player.Character
			if char and not espModels[char] then
				local box = Instance.new("SelectionBox")
				box.Adornee = char
				box.LineThickness = 0.08
				box.Color3 = Color3.fromRGB(255, 59, 127)
				box.SurfaceColor3 = Color3.fromRGB(255, 59, 127)
				box.SurfaceTransparency = 0.7
				box.Parent = workspace.CurrentCamera
				espModels[char] = box
			end
		end
	end
	stats.fakes = found
end

----------------------------------------------------------------------
-- Loops
----------------------------------------------------------------------

local function tick()
	if not scriptAlive() then
		return
	end
	confirmBuy()
	confirmShopPurchase("scanner")
	confirmShopPurchase("food")
	confirmSale()

	if not (isOn("farm") or isOn("rebirthFarm")) then
		state.pendingPrompt = nil
	end

	local didHatch = false
	if isOn("autoHatch") then
		didHatch = hatchReady() == true
	end

	if didHatch then
		drawEsp()
		return
	end

	local didUtilityAction = false
	if not isOn("protect") then
		if isOn("buyScanners") then
			didUtilityAction = shopStep("scanner")
		end
		if not didUtilityAction and isOn("buyFood") then
			didUtilityAction = shopStep("food")
		end
		if not didUtilityAction and isOn("autoSell") then
			didUtilityAction = sellStep()
		end
	end
	if didUtilityAction then
		drawEsp()
		return
	end

	if isOn("protect") then
		state.text = T.protectState
	elseif isOn("rebirthFarm") then
		farmStep("rebirth")
	elseif isOn("farm") then
		farmStep("normal")
	elseif isOn("steal") then
		stealStep()
	else
		state.text = T.idle
	end

	if isOn("rebirth") or isOn("upgrade") or isOn("equipBest") or isOn("disguise") then
		autoStep()
	end

	drawEsp()
end

