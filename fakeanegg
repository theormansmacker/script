----------------------------------------------------------------------
-- Anti-Detect & Movement Safeguards (Tween / Instant)
----------------------------------------------------------------------

local function character()
	local char = LocalPlayer.Character
	if char and char.Parent then
		return char
	end
	return nil
end

local function rootPart()
	local char = character()
	return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function safeWait(seconds)
	task.wait(seconds + math.random(5, 20) / 1000)
end

-- Universal Movement handler supporting Tween and Instant with anti-detect safeguards
local function movePlayer(targetPosition)
	local hrp = rootPart()
	if not hrp or typeof(targetPosition) ~= "Vector3" then
		return false
	end

	if Settings.movementMode == "Instant" then
		hrp.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
		return true
	else
		-- Tween flight mode
		local startPos = hrp.Position
		local distance = (targetPosition - startPos).Magnitude
		local duration = math.clamp(distance / math.max(Settings.tweenSpeed, 50), 0.1, 4.5)

		local oldAnchored = hrp.Anchored
		hrp.Anchored = true

		local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		local tween = TweenService:Create(hrp, tweenInfo, { CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0)) })
		tween:Play()

		local completed = false
		local conn
		conn = tween.Completed:Connect(function()
			completed = true
			if conn then conn:Disconnect() end
		end)

		local startTime = os.clock()
		while not completed and (os.clock() - startTime) < (duration + 1) do
			task.wait()
		end

		hrp.Anchored = oldAnchored
		return true
	end
end

local function teleport(position)
	return movePlayer(position)
end

local function promptPosition(prompt)
	local parent = prompt and prompt.Parent
	if not parent then
		return nil
	end
	if parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	if parent:IsA("BasePart") then
		return parent.Position
	end
	return parent:GetPivot().Position
end

-- Instant steal by simulating 'E' keypress and firing prompt
local function instantStealPrompt(prompt)
	if not prompt or not prompt.Parent then
		return false
	end
	local ok = pcall(function()
		if not prompt.Enabled then
			prompt.Enabled = true
		end
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.05)
		fireproximityprompt(prompt)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
	return ok
end

local function firePrompt(prompt)
	if not prompt or not prompt.Parent then
		return false
	end
	local ok = pcall(function()
		if not prompt.Enabled then
			prompt.Enabled = true
		end
		fireproximityprompt(prompt)
	end)
	return ok
end

